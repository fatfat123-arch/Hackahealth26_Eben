DB_HOST=database.example.com
DB_PORT=3306
DB_NAME=eh_passport
DB_USER=eh_passport_app
DB_PASSWORD=replace-me
# Optional separate account for schema/procedure installation and initial admin creation.
# Never grant DDL or direct users.role updates to the runtime DB_USER.
# DB_MIGRATION_USER=eh_passport_migrations
# DB_MIGRATION_PASSWORD=replace-me
MEDIA_ROOT=storage/media
MEDIA_SIGNING_SECRET=replace-with-at-least-24-random-characters
PUBLISHED_ORIGIN=http://localhost:8080
SWISS_IP_ONLY=false
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
CARTOONISER_PYTHON=python3
CARTOONISER_MAX_BYTES=104857600
CARTOONISER_TIMEOUT_MS=900000
